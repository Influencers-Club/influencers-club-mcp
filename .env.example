# Required: Your Influencers.club API key
INFLUENCERS_CLUB_API_KEY=Bearer your-api-key-here

# Required: Full path to your exports folder (where results are saved)
# Windows example: C:\Users\John\projects\influencers-club-mcp\exports
# macOS example: /Users/john/projects/influencers-club-mcp/exports
EXPORT_HOST_DIR=./exports

# Optional: Full path to imports folder (defaults to ./imports in the project)
# Windows example: C:\Users\John\projects\influencers-club-mcp\imports
# macOS example: /Users/john/projects/influencers-club-mcp/imports
IMPORT_HOST_DIR=./imports

# Optional: Upload page port (default 8090).
UPLOAD_PORT=8090
