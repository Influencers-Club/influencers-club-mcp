# Required: Your Influencers.club API key
INFLUENCERS_CLUB_API_KEY=Bearer your-api-key-here

# Required: Full path to your exports folder (where results are saved)
# Windows example: C:\Users\John\projects\influencers-club-mcp\exports
# macOS example: /Users/john/projects/influencers-club-mcp/exports
EXPORT_HOST_DIR=./exports

# Optional: Full path to imports folder (defaults to ./imports in the project)
# Windows example: C:\Users\John\projects\influencers-club-mcp\imports
# macOS example: /Users/john/projects/influencers-club-mcp/imports
IMPORT_HOST_DIR=./imports

# Optional: Upload page port (default 8090).
UPLOAD_PORT=8090

# ── Hosted (HTTP) transport + OAuth resource-server mode ────────────────────
# Only used when running as a remote/hosted MCP server; stdio mode ignores these.

# Transport: "stdio" (default, local) or "http" (hosted/remote).
# MCP_TRANSPORT=http
# Path the streamable-HTTP server is mounted at (default /mcp).
# MCP_PATH=/mcp
# CSV allowlists for DNS-rebinding/Origin protection in HTTP mode.
# ALLOWED_HOSTS=mcp-stage-dashboard.influencers.club
# ALLOWED_ORIGINS=https://claude.ai,https://claude.com,https://chatgpt.com,https://openai.com

# OAuth 2.1 resource-server mode. When enabled, the MCP validates dashboard-issued
# tokens via RFC 7662 introspection and exchanges them (RFC 8693) for a separate
# dashboard token before calling the API — it never forwards the user's token.
# MCP_OAUTH_ENABLED=true
# The IC dashboard as authorization server + API base. For stage, point BOTH at the
# stage dashboard so the exchanged token's audience matches the API host it's used on.
# OAUTH_ISSUER_URL=https://api-stage-dashboard.influencers.club
# OAUTH_API_BASE=https://api-stage-dashboard.influencers.club
# This MCP server's own canonical resource URL (RFC 8707 / RFC 9728) — MUST equal the
# `resource` the dashboard binds tokens to and what the client requests.
# OAUTH_RESOURCE_URL=https://mcp-stage-dashboard.influencers.club/mcp
# This MCP's confidential OAuth client (from the dashboard `create_mcp_client` command).
# The secret must come from a secret store (e.g. Secrets Manager), never committed.
# MCP_OAUTH_CLIENT_ID=ic_xxxxxxxx
# MCP_OAUTH_CLIENT_SECRET=ics_xxxxxxxx
# Optional: scopes to require/advertise; seconds to cache a validated token.
# OAUTH_SCOPES=
# OAUTH_CACHE_TTL=60
